# =============================================================================
# Stage 1 — Builder
# Installs ALL deps (including devDeps), generates the Prisma client,
# and compiles TypeScript to dist/.
# =============================================================================
FROM node:20-alpine AS builder

WORKDIR /app

# ── Install dependencies (dev + prod) ────────────────────────────────────────
COPY package.json package-lock.json ./
RUN npm ci --prefer-offline || npm ci --prefer-offline || npm ci

# ── Copy source files ─────────────────────────────────────────────────────────
COPY tsconfig.json ./
COPY prisma.config.ts ./
COPY prisma ./prisma
COPY src ./src

# ── Generate Prisma Client ────────────────────────────────────────────────────
# prisma.config.ts calls dotenv/config which looks for a .env file.
# At build time there is no .env, so we provide a dummy DATABASE_URL.
# This value is ONLY used during code generation — never at runtime.
ENV DATABASE_URL="postgresql://build:build@localhost:5432/build"
RUN npx prisma generate

# ── Compile TypeScript → dist/ ────────────────────────────────────────────────
RUN npm run build


# =============================================================================
# Stage 2 — Production runner
# Slim image with only production dependencies, the compiled code,
# and the generated Prisma client.
# =============================================================================
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# ── Install only production deps ──────────────────────────────────────────────
COPY package.json package-lock.json ./
RUN (npm ci --omit=dev --prefer-offline || npm ci --omit=dev --prefer-offline || npm ci --omit=dev) && npm cache clean --force

# ── Copy compiled app from builder ────────────────────────────────────────────
COPY --from=builder /app/dist ./dist

# ── Copy generated Prisma client from builder ─────────────────────────────────
COPY --from=builder /app/generated ./generated

# ── Copy Prisma schema + migrations (needed for migrate deploy at startup) ────
COPY prisma ./prisma

# ── Copy Prisma CLI binaries from builder (needed to run migrate deploy) ──────
COPY --from=builder /app/node_modules/.bin/prisma ./node_modules/.bin/prisma
COPY --from=builder /app/node_modules/prisma ./node_modules/prisma

# ── Copy prisma.config.ts + dotenv (needed by prisma migrate deploy in Prisma 7) ──
COPY --from=builder /app/prisma.config.ts ./prisma.config.ts
COPY --from=builder /app/node_modules/dotenv ./node_modules/dotenv

# ── Entrypoint: run migrations then start the server ─────────────────────────
COPY entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

# Run as non-root for security
USER node

EXPOSE 3000

CMD ["./entrypoint.sh"]
